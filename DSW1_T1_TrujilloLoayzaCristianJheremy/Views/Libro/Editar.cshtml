@model Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Libro (ID: @Model.Id)</h4>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Mensaje != null)
                {
                    var tipo = ViewBag.TipoMensaje ?? "danger";
                    <div class="alert alert-@tipo alert-dismissible fade show" role="alert">
                        @ViewBag.Mensaje
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }

                <form asp-action="Editar" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Id" class="form-label fw-semibold"></label>
                        <input asp-for="Id" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NombreLibro" class="form-label fw-semibold"></label>
                        <input asp-for="NombreLibro" class="form-control" maxlength="120" required />
                        <span asp-validation-for="NombreLibro" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Autor" class="form-label fw-semibold"></label>
                        <input asp-for="Autor" class="form-control" maxlength="100" required />
                        <span asp-validation-for="Autor" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NombreEditorial" class="form-label fw-semibold"></label>
                        <input asp-for="NombreEditorial" class="form-control" maxlength="100" required />
                        <span asp-validation-for="NombreEditorial" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ISDN" class="form-label fw-semibold"></label>
                        <input asp-for="ISDN" class="form-control" maxlength="20" required />
                        <span asp-validation-for="ISDN" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-warning text-dark fw-semibold px-4">
                            <i class="bi bi-check-circle me-1"></i>Actualizar Datos
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
