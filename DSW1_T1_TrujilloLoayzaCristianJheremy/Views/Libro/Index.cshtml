@model IEnumerable<Libro>

@{
    ViewData["Title"] = "Listado de Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold text-dark mb-0">Catálogo de Libros</h2>
        <p class="text-muted small mb-0">Mantenimiento CRUD - Base de datos BDBIBLIOTECA2026</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="BuscarPorAutor" class="btn btn-outline-primary">
            <i class="bi bi-search me-1"></i>Buscar por Autor
        </a>
        <a asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Registrar Libro
        </a>
    </div>
</div>

@if (ViewBag.Mensaje != null)
{
    var tipo = ViewBag.TipoMensaje ?? "info";
    <div class="alert alert-@tipo alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i>@ViewBag.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">@Html.DisplayNameFor(model => model.Id)</th>
                        <th>@Html.DisplayNameFor(model => model.NombreLibro)</th>
                        <th>@Html.DisplayNameFor(model => model.Autor)</th>
                        <th>@Html.DisplayNameFor(model => model.NombreEditorial)</th>
                        <th>@Html.DisplayNameFor(model => model.ISDN)</th>
                        <th class="text-center pe-3" style="width: 210px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">@item.Id</td>
                                <td>@item.NombreLibro</td>
                                <td>@item.Autor</td>
                                <td>@item.NombreEditorial</td>
                                <td><span class="badge bg-secondary">@item.ISDN</span></td>
                                <td class="text-center pe-3">
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning btn-sm text-dark fw-semibold me-1">
                                        <i class="bi bi-pencil-square me-1"></i>Editar
                                    </a>
                                    <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Está seguro de que desea eliminar el libro &quot;@item.NombreLibro&quot;? Esta acción no se puede deshacer.');">
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash me-1"></i>Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No se encontraron libros registrados en la base de datos.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
